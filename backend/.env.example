# کلید API لایه یکپارچه‌سازی LIS (نرم‌افزار ثالث) — هدر X-API-Key
# اگر خالی باشد مسیر /api/v1/integrations/* غیرفعال (503) است
INTEGRATION_LIS_API_KEY=

# مدیریت منابع GPS در ادمین (جداول جدا). برای خاموشی فوری: false
GPS_ADMIN_ENABLED=true

# محاسبه GPS در مالی — برای خاموشی فوری: false
GPS_FINANCE_ENABLED=true
KING_GPS_API_URL=https://mihan.kinggps.ir/api/api.php
KING_GPS_API_KEY=

# Bale messenger (optional — module disabled if unset)
BALE_BOT_TOKEN=
# آدرس عمومی سرور برای لینک فایل گزارش بله (مثلاً https://movex.mihan.co.ir)
PUBLIC_API_BASE_URL=
# Optional secret header for webhook: X-Bale-Webhook-Secret
BALE_WEBHOOK_SECRET=
# دریافت پیام راننده بدون webhook (پیش‌فرض: فعال اگر false نباشد)
BALE_ENABLE_POLLING=true
